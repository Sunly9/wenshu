# ===== 镜像来源：改成你的 GHCR 地址（必须全小写）=====
IMAGE_PREFIX=ghcr.io/yourname/repomind
IMAGE_TAG=latest

# ===== 对外端口：国内服务器 80 常被占用/需备案，默认用 8080 =====
HTTP_PORT=8080

# ===== 数据库 =====
POSTGRES_DB=repomind
POSTGRES_USER=repomind
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# ===== 大模型：填你自己的 Key，绝不要提交进 Git =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 防刷：每个 IP 每天允许的提问次数 =====
APP_RATE_LIMIT_PER_IP=50
